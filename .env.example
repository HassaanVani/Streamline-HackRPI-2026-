# Vultr Docker deployment. Use :80 for an initial HTTP demo at the instance IP.
# Set a domain with an A record pointing to the instance for automatic HTTPS.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443
# Local frontend development already proxies /api to port 8000.
# Set in frontend/.env.local only when using a separate API host:
# VITE_API_BASE_URL=http://127.0.0.1:8000
